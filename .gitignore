# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Padroes SEM barra inicial de proposito: o repositorio tem mais de um
# projeto (web/ e whatsapp/), e regra ancorada na raiz so pegaria o que
# estivesse na raiz — deixando o .next e o node_modules de cada subprojeto
# entrarem no git sem ninguem notar.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)

.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
.worktrees/

# Dumps de banco: contêm hashes de senha e e-mails reais.
backups/
