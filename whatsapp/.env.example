# Mesmo banco do web/. Cada processo lê o .env da própria pasta — o Next não
# enxerga este arquivo, e este serviço não enxerga o de lá.
DATABASE_URL="postgresql://postgres:password@localhost:5432/scaleflow"

# Porta do servidor de controle (/qr e /health).
PORT=3100

# Fuso das igrejas. `schedule_dates` guarda hora de parede, sem fuso nenhum.
TIMEZONE="America/Sao_Paulo"

# Onde o Baileys grava o pareamento. PRECISA ser volume persistente: se sumir,
# o QR tem que ser lido de novo, e ninguém descobre isso sozinho.
SESSION_DIR="./.session"

# Quanto tempo depois do horário ainda vale enviar. Sem tolerância, um minuto
# de indisponibilidade pula o aviso; com tolerância demais, volta o problema do
# lembrete que chega depois do culto.
TOLERANCE_MINUTES=15

# Intervalo entre mensagens, sorteado nesta faixa a cada envio.
#
# Faixa larga de proposito: um intervalo EXATO e um padrao tao reconhecivel
# quanto uma rajada — 10s cravados entre cada mensagem nao parece gente. Com
# 20 a 55s, dois intervalos seguidos raramente se repetem.
#
# O custo e a fila ficar mais longa: um setor de 6 pessoas leva ~3 min. Isso
# nao atrasa ninguem para fora da janela de tolerancia, porque o ciclo decide
# quem vence ANTES de comecar a enviar.
SEND_DELAY_MIN_MS=20000
SEND_DELAY_MAX_MS=55000

# Recorte da busca, para não varrer o histórico a cada minuto.
LOOKBACK_HOURS=48
LOOKAHEAD_HOURS=48

# true: decide tudo e registra no banco, mas NÃO envia. Use no primeiro dia em
# produção para conferir quem receberia, antes de mandar de verdade.
DRY_RUN=false

# Habilita POST /test-send, para mandar uma mensagem avulsa e conferir como
# ela chega. Sem isto a rota nem e registrada: um endpoint que dispara
# WhatsApp para qualquer numero e um relay aberto, e o numero aqui e pessoal.
CONTROL_TOKEN=""

# Endereco publico do app, para o link no fim da mensagem. Sem ele a linha do
# link nao sai — link quebrado e pior que link nenhum.
APP_URL="https://scaleflow.flowintic.com.br"

# Quanto tempo depois de publicada uma escala ainda vale avisar o setor.
# Sem esta janela, o primeiro ciclo apos subir o servico avisaria de toda
# escala publicada que existe — inclusive as de meses atras.
PUBLISHED_WINDOW_HOURS=48
